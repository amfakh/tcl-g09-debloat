<?xml version="1.0" encoding="utf-8"?>
<!-- Read-only probe: lists what the TV provider shows an ordinary app holding READ_TV_LISTINGS,
     the same view a third-party launcher gets. No launcher entry, no network. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.tcl.tvprobe"
    android:versionCode="1"
    android:versionName="1">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="31" />

    <uses-permission android:name="android.permission.READ_TV_LISTINGS" />

    <application android:label="TV probe" android:hasCode="true">
        <activity
            android:name=".ProbeActivity"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay" />
        <activity
            android:name=".LivePreviewActivity"
            android:exported="true"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen" />
    </application>
</manifest>
